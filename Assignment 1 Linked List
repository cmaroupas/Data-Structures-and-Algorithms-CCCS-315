/*
This Node class represents a node in a Singly Linked List.
Each node contains an int value and a reference to the next node in the list
*/
public class Node {
    int value; // variable used to store the value of a node
    Node next; // variable holding a reference to the subsequent node in the list

    /**
     * This constructor initializes the value and next properties of the Node
     *
     * @param value the value to be stored in the Node
     */
    public Node(int value) {
        this.value = value; // initializes the value of the node
        next = null; // sets the reference to the next node as null
    }
}
